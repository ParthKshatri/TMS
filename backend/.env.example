PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/taskdb
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
MAIL_SENDER_EMAIL=noreply@yourdomain.com
MAIL_SENDER_NAME=Task Management System
APP_LOGIN_URL=http://localhost:5173/login

# Admin Seed Configuration (Multiple Admins Supported)
SEED_ADMIN_NAME=Primary Administrator
SEED_ADMIN_EMAIL=admin@tms.local
SEED_ADMIN_PASSWORD=AdminPassword123!

SEED_ADMIN_2_NAME=Secondary Administrator
SEED_ADMIN_2_EMAIL=admin2@tms.local
SEED_ADMIN_2_PASSWORD=AdminPassword123!

# Alternatively pass a JSON array string:
# SEED_ADMINS_JSON='[{"name":"Admin 1","email":"admin1@example.com","password":"Pass"},{"name":"Admin 2","email":"admin2@example.com","password":"Pass"}]'
